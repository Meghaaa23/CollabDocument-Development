# Copy to .env to override defaults. All are optional for local dev.

# Storage. Default is a local SQLite file. For Postgres:
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./collabdocs.db

# Sign JWTs. MUST be set to a strong random value in production.
JWT_SECRET=dev-secret-change-me

# Password for the seeded demo accounts (alice/bob/carol @example.com).
DEMO_PASSWORD=demo1234

# Allowed SPA origins for CORS during local dev.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max upload size in bytes (default 5 MB).
MAX_UPLOAD_BYTES=5242880
